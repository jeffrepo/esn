<odoo>
    <record id="esn_stock_picking_kanban_inherit_marketplace" model="ir.ui.view">
        <field name="name">esn.stock.picking.kanban.inherit.marketplace</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.stock_picking_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_properties']" position="before">
                <field name="x_studio_marketplace_id" display="full"/>
            </xpath>
        </field>
    </record>
</odoo>
